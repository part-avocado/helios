// The teardrop website on Cloudflare Workers: the pages in ../site, sign-in,
// each person's synced stats in D1, and every report they sent in R2.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "teardrop",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-21",
	// Keep variables added in the Cloudflare dashboard, such as ADMINS added as
	// text instead of as a secret. Without this, every deploy removes them.
	"keep_vars": true,
	"assets": {
		"directory": "../site",
		"binding": "ASSETS",
		// These reach the Worker before the files in ../site: the API, sign-in
		// (and signing in to other sites with teardrop),
		// the pages that need an account, the review app and its old addresses,
		// the home page, docs, and profiles, which show an account menu to
		// signed-in visitors.
		"run_worker_first": [
			"/api/*",
			"/auth/*",
			"/logout",
			"/authorize",
			"/login",
			"/login.html",
			"/dashboard",
			"/dashboard.html",
			"/settings",
			"/settings.html",
			"/review",
			"/review/*",
			"/people",
			"/person",
			"/",
			"/index.html",
			"/docs",
			"/docs.html",
			// Public profiles, /@handle.
			"/@*"
		]
	},
	"d1_databases": [
		{
			// The first deploy creates this database.
			"binding": "DB",
			"database_name": "teardrop",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			// Every report people's computers send, kept in full for reviewers.
			// The first deploy creates this bucket, once R2 is turned on for the
			// account.
			"binding": "REPORTS"
		}
	],
	// Hourly, ask GitHub which claimed commits exist (src/git.ts).
	"triggers": { "crons": ["17 * * * *"] },
	"vars": {
		"HCA_URL": "https://auth.hackclub.com",
		// Where the commit check asks GitHub; tests point it elsewhere. The
		// check needs a GITHUB_TOKEN secret, and is off without one.
		"GITHUB_API": "https://api.github.com",
		// Local testing only: signs every visitor in as this Slack user ID. Set
		// it in .dev.vars. It is ignored on any address but localhost.
		"DEV_LOGIN": ""
	},
	// Secrets (SESSION_SECRET, HCA_CLIENT_ID, HCA_CLIENT_SECRET, ADMINS) are not
	// listed here, so a first deploy works before they exist. Set them in the
	// dashboard, under the Worker's Settings, Variables and Secrets. For local
	// runs they come from .dev.vars.
	// One UserHub per account takes its prompt records as they happen (src/hub.ts).
	"durable_objects": {
		"bindings": [{ "name": "HUB", "class_name": "UserHub" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["UserHub"] }],
	"observability": {
		"enabled": true,
		// Keep a tenth of request logs, so logging stays cheap as people join.
		"head_sampling_rate": 0.1,
		"traces": { "enabled": true }
	}
}

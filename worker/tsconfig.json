{
	"compilerOptions": {
		"target": "es2024",
		"module": "es2022",
		"moduleResolution": "bundler",
		"lib": [
			"es2024"
		],
		"types": [
			"./worker-configuration.d.ts"
		],
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true
	},
	"include": [
		"src"
	]
}
